# Public site URL used for metadata, canonical URLs, and sitemap output.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-FXQGWE9XZ0

# Next -> Spring CMS backend. This secret is server-only; never expose it with NEXT_PUBLIC_.
CMS_BACKEND_URL=http://localhost:8080
CMS_BACKEND_API_KEY=replace-with-a-long-random-key

# Customer accounts are fail-closed until both flags and all Cognito/SOLAPI
# credentials below have been configured. Keep inquiry enforcement false during rollout.
CUSTOMER_ACCOUNTS_ENABLED=false
INQUIRY_ACCOUNT_REQUIRED=false
CUSTOMER_BACKEND_URL=http://localhost:8081
CUSTOMER_DB_SCHEMA=customer_account
CUSTOMER_INTERNAL_API_KEY=replace-with-a-separate-long-random-key
CUSTOMER_VERIFICATION_HMAC_SECRET=replace-with-at-least-32-random-characters
CUSTOMER_TERMS_VERSION=terms-2026-09
CUSTOMER_PRIVACY_VERSION=privacy-2026-09
AUTH_SESSION_SECRET=replace-with-a-different-32-character-random-secret

# Cognito User Pool in ap-northeast-2. Use exact callback/logout URLs and a public
# app client with Authorization Code + PKCE; do not configure a client secret.
CUSTOMER_AUTH_MODE=disabled
COGNITO_REGION=ap-northeast-2
COGNITO_ISSUER_URI=https://cognito-idp.ap-northeast-2.amazonaws.com/ap-northeast-2_REPLACE
COGNITO_DOMAIN=https://login.daeho.works
COGNITO_CLIENT_ID=

# SOLAPI has no monthly API fee. The sender number must already be registered in
# the SOLAPI console. Leaving any credential empty disables SMS verification.
SOLAPI_API_BASE_URL=https://api.solapi.com
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=

# Optional overseas email registration. Keep disabled until SMTP is verified.
CUSTOMER_EMAIL_MODE=disabled
CUSTOMER_EMAIL_FROM=

# Static CMS preview mode for Vercel/browser-only review links.
# Commit a generated data/cms-preview.json and set CMS_PREVIEW_STATIC=true when no Spring backend is deployed.
CMS_PREVIEW_STATIC=false
PREVIEW_NOINDEX=false

# PostgreSQL defaults used by docker compose.
POSTGRES_DB=daeho_cms
POSTGRES_USER=daeho
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Spring Boot CMS service.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/daeho_cms
SPRING_DATASOURCE_USERNAME=daeho
SPRING_DATASOURCE_PASSWORD=replace-with-a-strong-database-password
CMS_ADMIN_API_KEY=replace-with-the-same-value-as-CMS_BACKEND_API_KEY
CMS_CUSTOMER_LINK_API_KEY=replace-with-the-same-value-as-CUSTOMER_INTERNAL_API_KEY
CMS_UPLOAD_DIR=./data/uploads
CMS_PUBLIC_UPLOAD_BASE_URL=/uploads
CMS_STORAGE_PROVIDER=local
CMS_S3_BUCKET=daeho-prod-media
CMS_S3_REGION=ap-northeast-2
CMS_S3_ENDPOINT=
CMS_S3_PUBLIC_BASE_URL=https://daeho-prod-media.s3.ap-northeast-2.amazonaws.com
CMS_S3_ACCESS_KEY_ID=replace-with-lightsail-access-key
CMS_S3_SECRET_ACCESS_KEY=replace-with-lightsail-secret-key

# Next admin page login/session. The Spring CMS backend also receives
# CMS_ADMIN_PASSWORD as the first bootstrap password until it is changed
# in /admin/account and stored as a PostgreSQL hash.
CMS_ADMIN_PASSWORD=replace-with-a-strong-password
# Required before enabling multi-user login in production.
CMS_OWNER_EMAIL=owner@example.com
CMS_ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret
# Optional. Comma- or space-separated IP/CIDR allowlist for /admin and /api/admin.
# Leave empty for local development. Example: 203.0.113.10/32,198.51.100.0/24
ADMIN_ALLOWED_IPS=
# Optional. Leave empty for automatic behavior:
# - HTTPS production domain: secure cookie on
# - local http://localhost production container: secure cookie off
CMS_ADMIN_COOKIE_SECURE=

# Inquiry notifications. Keep all CMS channel switches disabled until their
# provider connections and templates have been verified in /admin/notifications.
CMS_NOTIFY_TO=inquiries@example.com
CMS_ADMIN_BASE_URL=https://example.com/admin
CMS_NOTIFICATION_WORKER_ENABLED=true
CMS_NOTIFICATION_WORKER_DELAY_MS=1000

# Google Workspace SMTP Relay. Add the Lightsail static IP to the Workspace
# relay allowlist and use a sender address in the company domain.
SMTP_FROM=no-reply@example.com
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH=false
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
SMTP_USER=
SMTP_PASS=

# SOLAPI Kakao Alimtalk. These credentials stay server-side.
# SMS fallback is hard-disabled in every application request.
SOLAPI_API_BASE_URL=https://api.solapi.com
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PF_ID=

# Telegram group notifications. The server-side key encrypts the Bot Token that
# administrators enter in CMS; the Token itself must never be stored in this file.
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Generate once with: openssl rand -base64 32
# Keep this stable across backups/restores. Telegram Bot Token and Chat ID are entered in CMS.
CMS_TELEGRAM_ENCRYPTION_KEY=

# Embedded web live chat. Generate a unique secret with: openssl rand -base64 32
# These values are passed only to the CMS container at runtime.
CMS_LIVE_CHAT_SESSION_SECRET=replace-with-a-long-random-live-chat-session-secret
CMS_LIVE_CHAT_ALLOWED_ORIGINS=https://daeho.works

# Docker compose ports and backup interval.
HTTP_PORT=80
BACKUP_INTERVAL_SECONDS=86400
