# Public site URL used for metadata, canonical URLs, and sitemap output.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local SQLite CMS database path. Keep production storage persistent.
CMS_DB_PATH=./data/cms.sqlite

# Admin API and admin page login.
# In production, set all three values.
CMS_ADMIN_API_KEY=replace-with-a-long-random-key
CMS_ADMIN_PASSWORD=replace-with-a-strong-password
CMS_ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret

# Inquiry notification email.
# If these are not configured, inquiries are still stored and email events are marked as skipped.
CMS_NOTIFY_TO=admin@example.com
SMTP_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
