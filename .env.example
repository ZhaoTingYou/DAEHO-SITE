# Public site URL used for metadata, canonical URLs, and sitemap output.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-FXQGWE9XZ0
# Public image/video origin compiled into the Next.js browser bundle.
NEXT_PUBLIC_MEDIA_BASE_URL=https://daeho-prod-media.s3.ap-northeast-2.amazonaws.com

# Next -> Spring CMS backend. This secret is server-only; never expose it with NEXT_PUBLIC_.
CMS_BACKEND_URL=http://localhost:8080
CMS_BACKEND_API_KEY=replace-with-a-long-random-key

# Static CMS preview mode for Vercel/browser-only review links.
# Commit a generated data/cms-preview.json and set CMS_PREVIEW_STATIC=true when no Spring backend is deployed.
CMS_PREVIEW_STATIC=false
PREVIEW_NOINDEX=false

# PostgreSQL defaults used by docker compose.
POSTGRES_DB=daeho_cms
POSTGRES_USER=daeho
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Spring Boot CMS service.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/daeho_cms
SPRING_DATASOURCE_USERNAME=daeho
SPRING_DATASOURCE_PASSWORD=replace-with-a-strong-database-password
CMS_ADMIN_API_KEY=replace-with-the-same-value-as-CMS_BACKEND_API_KEY
CMS_UPLOAD_DIR=./data/uploads
CMS_PUBLIC_UPLOAD_BASE_URL=/uploads
CMS_STORAGE_PROVIDER=s3
CMS_S3_BUCKET=daeho-prod-media
CMS_S3_REGION=ap-northeast-2
CMS_S3_ENDPOINT=
CMS_S3_PUBLIC_BASE_URL=https://daeho-prod-media.s3.ap-northeast-2.amazonaws.com
CMS_S3_ACCESS_KEY_ID=replace-with-lightsail-access-key
CMS_S3_SECRET_ACCESS_KEY=replace-with-lightsail-secret-key

# Next admin page login/session. The Spring CMS backend also receives
# CMS_ADMIN_PASSWORD as the first bootstrap password until it is changed
# in /admin/account and stored as a PostgreSQL hash.
CMS_ADMIN_PASSWORD=replace-with-a-strong-password
CMS_ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret
# Optional. Comma- or space-separated IP/CIDR allowlist for /admin and /api/admin.
# Leave empty for local development. Example: 203.0.113.10/32,198.51.100.0/24
ADMIN_ALLOWED_IPS=
# Optional. Leave empty for automatic behavior:
# - HTTPS production domain: secure cookie on
# - local http://localhost production container: secure cookie off
CMS_ADMIN_COOKIE_SECURE=

# Inquiry notification email.
# If these are not configured, inquiries are still stored and email events are marked as skipped.
CMS_NOTIFY_TO=admin@example.com
SMTP_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user
SMTP_PASS=smtp-password

# Docker compose ports and backup interval.
HTTP_PORT=80
BACKUP_INTERVAL_SECONDS=86400
